@inject IJSRuntime JsRuntime

<div class="swiper-container">
    <button class="nav-btn-prev">
        <i class="bi bi-chevron-left"></i>
    </button>
    <div class="d-flex flex-grow-1 align-items-center overflow-x-auto swiper-content">
        @foreach(var castMember in Cast)
        {
            <ActorSwiperItem CastMember="castMember"></ActorSwiperItem>
        }
    </div>
    <button class="nav-btn-next">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] 
    public List<MovieCastMember?> Cast { get; set; } = [];
}
