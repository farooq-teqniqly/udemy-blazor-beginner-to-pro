meta {
  name: Get OpenAPI document
  type: http
  seq: 2
}

get {
  url: {{API_URL}}/openapi/v1.json
  body: none
  auth: inherit
}

assert {
  res.body.paths["/api/TaskerItems"].get: isDefined
  res.body.paths["/api/TaskerItems"].post: isDefined
  res.body.paths["/api/TaskerItems/{id}"].get: isDefined
  res.body.paths["/api/TaskerItems/{id}"].put: isDefined
  res.body.paths["/api/TaskerItems/{id}"].delete: isDefined
  res.body.paths["/register"].post: isDefined
  res.body.paths["/login"].post: isDefined
  res.body.paths["/refresh"].post: isDefined
  res.body.paths["/confirmEmail"].get: isDefined
  res.body.paths["/resendConfirmationEmail"].post: isDefined
  res.body.paths["/forgotPassword"].post: isDefined
  res.body.paths["/resetPassword"].post: isDefined
  res.body.paths["/manage/2fa"].post: isDefined
  res.body.paths["/manage/info"].get: isDefined
  res.body.paths["/manage/info"].post: isDefined
}

settings {
  encodeUrl: true
  timeout: 0
}
