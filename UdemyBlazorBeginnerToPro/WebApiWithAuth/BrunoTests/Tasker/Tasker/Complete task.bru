meta {
  name: Complete task
  type: http
  seq: 3
}

put {
  url: {{API_URL}}/api/taskeritems/2
  body: json
  auth: inherit
}

body:json {
  {
    "id": "2",
    "name": "{{TASK_NAME}}",
    "completed": true
  }
}

assert {
  res.status: eq 204
}

script:pre-request {
  const taskNames = ["Wash dishes", "Write code", "Exercise", "Read a book", "Buy groceries"];
  const index = Math.floor(Math.random() * taskNames.length);
  
  bru.setVar("TASK_NAME", taskNames[index]);
}

settings {
  encodeUrl: true
  timeout: 0
}
